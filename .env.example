# ClipOps — copy to .env then rotate secrets before any shared/prod use:
#   python scripts/rotate_secrets.py --production --print-password

CLIPOPS_ENV=development

# Operator auth
OPERATOR_EMAIL=operator@clipops.local
# Leave blank after hashing — use rotate_secrets.py
OPERATOR_PASSWORD=changeme
OPERATOR_PASSWORD_HASH=
# MUST be replaced (rotate_secrets.py). Weak values fail production startup.
JWT_SECRET=REPLACE_ME_RUN_rotate_secrets
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Local Supabase (from `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# docker-compose postgres OR local sqlite for zero-deps smoke
DATABASE_URL=sqlite:///./clipops.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/clipops

# Storage bucket for source assets + exports
STORAGE_BUCKET=clipops

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# WhisperX (CUDA 12.8 / RTX 50-series — see scripts/install_whisperx_cuda.py)
WHISPERX_MODEL=medium
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
# Optional speaker diarization (accept pyannote model terms on Hugging Face)
HF_TOKEN=
ENABLE_DIARIZATION=true

# Content Rewards economics (constants)
PLATFORM_FEE_MULTIPLIER=0.93
BUDGET_UTILISATION_REJECT_THRESHOLD=0.90
VIEW_VALIDATION_DAYS=3
SUBMISSION_REVIEW_DAYS=7

# Paths / render
STORAGE_ROOT=./storage
FFMPEG_PATH=ffmpeg
AUTO_EDITOR_ENABLED=false
CELERY_EAGER=true
REMOTION_URL=http://127.0.0.1:3100
BURN_CAPTIONS=true
MAX_UPLOAD_MB=512

# Manual workflow URLs (opened by operator, never automated)
TIKTOK_URL=https://www.tiktok.com
CONTENT_REWARDS_URL=https://www.contentrewards.com

# ---------------------------------------------------------------------------
# Live clipper + auto-poster (workers/live_clipper, workers/publisher)
# ---------------------------------------------------------------------------
# Twitch scout (free app: dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Grok writes titles/captions and safety-reviews every clip before auto-post (console.x.ai)
XAI_API_KEY=
# Optional: pin a model id from `python -m workers.publisher grok-test` (blank = newest grok-*)
XAI_MODEL=
# Ayrshare: public posting to YouTube/TikTok/Instagram through their audited apps (ayrshare.com)
AYRSHARE_API_KEY=
AYRSHARE_PROFILE_KEY_A=
AYRSHARE_PROFILE_KEY_B=
# Official APIs (optional; YouTube/TikTok post PRIVATE until your own app is audited)
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
# Phone notifications for every post / hold (Discord channel webhook URL)
DISCORD_WEBHOOK_URL=
