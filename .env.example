# ClipOps — copy to .env then rotate secrets before any shared/prod use:
#   python scripts/rotate_secrets.py --production --print-password

CLIPOPS_ENV=development

# Operator auth
OPERATOR_EMAIL=operator@clipops.local
# Leave blank after hashing — use rotate_secrets.py
OPERATOR_PASSWORD=changeme
OPERATOR_PASSWORD_HASH=
# MUST be replaced (rotate_secrets.py). Weak values fail production startup.
JWT_SECRET=REPLACE_ME_RUN_rotate_secrets
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Local Supabase (from `npx supabase start`)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# docker-compose postgres OR local sqlite for zero-deps smoke
DATABASE_URL=sqlite:///./clipops.db
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/clipops

# Storage bucket for source assets + exports
STORAGE_BUCKET=clipops

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Dashboard
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# WhisperX (CUDA 12.8 / RTX 50-series — see scripts/install_whisperx_cuda.py)
WHISPERX_MODEL=medium
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
# Optional speaker diarization (accept pyannote model terms on Hugging Face)
HF_TOKEN=
ENABLE_DIARIZATION=true

# Content Rewards economics (constants)
PLATFORM_FEE_MULTIPLIER=0.93
BUDGET_UTILISATION_REJECT_THRESHOLD=0.90
VIEW_VALIDATION_DAYS=3
SUBMISSION_REVIEW_DAYS=7

# Paths / render
STORAGE_ROOT=./storage
FFMPEG_PATH=ffmpeg
AUTO_EDITOR_ENABLED=false
CELERY_EAGER=true
REMOTION_URL=http://127.0.0.1:3100
BURN_CAPTIONS=true
MAX_UPLOAD_MB=512

# Manual workflow URLs (opened by operator, never automated)
TIKTOK_URL=https://www.tiktok.com
CONTENT_REWARDS_URL=https://www.contentrewards.com

# Clip ranking LLM. NVIDIA is primary; Gemini is the fallback.
#
# Pin the model explicitly. NVIDIA retires hosted models on a schedule and a
# retired one returns HTTP 410, which drops ranking to the keyword ranker -
# deepseek-v4-flash reached end of life on 2026-08-07T09:00:00Z mid-run.
#
# nemotron-nano-9b-v2 was chosen over llama-3.3-nemotron-super-49b-v1.5 on a
# bake-off against a known-good transcript: 100s vs 898s, and it recovered the
# benchmark clip the 49B reasoning model missed.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nvidia-nemotron-nano-9b-v2
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
