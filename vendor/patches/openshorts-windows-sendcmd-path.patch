+def _ffmpeg_path(path):
+    """Path usable inside an ffmpeg filtergraph argument.
+
+    Windows-compatibility shim (local change to the vendored file): forward
+    slashes, and the drive-letter colon escaped, since the filtergraph parser
+    reads both as syntax. A no-op on POSIX paths.
+    """
+    return str(path).replace("\\", "/").replace(":", "\\:")
+
